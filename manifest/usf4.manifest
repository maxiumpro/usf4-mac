# SSFIV.exe (USF4, build 834219): manifest del lifter (generado por tools/armar_manifest.py; no editar a mano)
#
# entry <va> [nombre]   función que Ghidra no encontró (destino indirecto)
# setjmp <va> [nombre]  función tipo setjmp: sus llamantes son reanudables
# resume <va>           call/jmp que abandona la cadena de llamadas (GuestResume)

## CRT de VS2010 (por patrón de bytes)
# setjmp de la CRT: cada retorno de una llamada directa es punto de reanudación (1 en este módulo)
setjmp 8cd610 __setjmp3
# longjmp: jmp [jmp_buf+14h] con ebp/esp del llamante de setjmp ya restaurados (1 en este módulo)
resume 8cda2a
# _EH4_TransferToHandler: jmp esi al bloque __except, ebp = marco dueño (1 en este módulo)
resume 8df580
# _JumpToContinuation: jmp eax a la continuación del catch, ebp = marco dueño (1 en este módulo)
resume 8c5b31
# HIPOTESIS: prólogo SEH4 (registra el marco del llamante) (2 en este módulo)
setjmp 8d0170 __SEH_prolog4
setjmp 8eb720 __SEH_prolog4
# HIPOTESIS: prólogo C++ EH3 (registra el marco del llamante) (2 en este módulo)
setjmp 8d3ed5 __EH_prolog3
setjmp 8d3f08 __EH_prolog3
# llamadas directas a cada función setjmp: 8cd610=8, 8d0170=66, 8eb720=1, 8d3ed5=4, 8d3f08=2

